      <harmony print-frame="no">
        <root><root-step>E</root-step></root>
        <kind text="m">minor</kind>
        <bass><bass-step>B</bass-step></bass>
      </harmony>
      <!-- Beam 1: 2 eighths UP (low) -->
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>up</stem><staff>1</staff><beam number="1">begin</beam></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>up</stem><staff>1</staff><beam number="1">end</beam></note>
      <!-- Beam 2: 4 eighths DOWN (high, descending) ; slur start at last note -->
